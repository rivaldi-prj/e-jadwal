# ==============================================================================
# KONFIGURASI SUPABASE CLOUD - E-JADWAL ZOOM S1 KEBIDANAN
# ==============================================================================
# Salin file ini menjadi .env dan masukkan Project URL serta Anon Key dari:
# https://supabase.com -> Project Settings -> API
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# KONFIGURASI EMAILJS (Opsional - Bisa juga diisi via Menu Pengelola Web)
# ==============================================================================
# Dapatkan dari: https://dashboard.emailjs.com
#   Service ID  -> Email Services -> klik service Anda -> lihat "Service ID"
#   Template ID -> Email Templates -> klik template -> lihat "Template ID"
#   Public Key  -> Account -> General -> "Public Key"
# ==============================================================================

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_APPROVED=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_REJECTED=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

